{
  "name": "anajaksmp-store",
  "version": "1.0.0",
  "private": true,
  "description": "AnajakSMP.xyz - Premium Minecraft Survival Store & Ecommerce Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "concurrently -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=apps/api"
  },
  "keywords": [
    "minecraft",
    "store",
    "ecommerce",
    "khqr",
    "payway",
    "anajaksmp",
    "supabase"
  ],
  "author": "AnajakSMP Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}
