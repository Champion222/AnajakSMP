# ==============================================================================
# AnajakSMP Backend Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# IMPORTANT: Service Role Key has full database bypass access and must NEVER be exposed to frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Authentication
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_PANEL_PATH=/control-panel

# ABA PayWay Integration (Leave empty to use Sandbox Simulation Mode)
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_SANDBOX=true

# Bakong KHQR Integration (Leave empty to use Sandbox Simulation Mode)
KHQR_MERCHANT_ID=
KHQR_BAKONG_ACCOUNT=
KHQR_MERCHANT_NAME=AnajakSMP Store
KHQR_MERCHANT_CITY=Phnom Penh

# Minecraft Java Server Integration (RCON)
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
MINECRAFT_RCON_TIMEOUT=5000
MINECRAFT_SERVER_STATUS_HOST=play.anajaksmp.xyz
